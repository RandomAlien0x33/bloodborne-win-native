// RCAS on the resolved scene only. The unsharpened history and HUD are untouched.
// Strength 0..2: above 1 the RCAS change is extrapolated (stronger than AMD's maximum). The
// same pass sharpens FSR 3/4 output beyond their own RCAS (LDR_OUTPUT: the 8-bit UI image).
// FUSED_INPUT: DLSS / FSR 4 output (rgba16f) read directly and written to the UI image, in place
// of a copy, this pass and a blit; SRGB_OUTPUT encodes for an sRGB UI image (its UNORM view).
#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
#ifdef FUSED_INPUT
layout(binding = 0, rgba16f) uniform readonly image2D resolved_img;
#else
layout(binding = 0, rgba32f) uniform readonly image2D resolved_img;
#endif
#ifdef LDR_OUTPUT
layout(binding = 1, rgba8) uniform writeonly image2D result_img;
#else
layout(binding = 1, rgba16f) uniform writeonly image2D result_img;
#endif
layout(push_constant) uniform Params { float strength; };
#define A_GPU 1
#define A_GLSL 1
#include "fsr/ffx_a.h"
#define FSR_RCAS_F 1
#define FSR_RCAS_DENOISE 1
float color_scale;
vec3 loadColor(ivec2 p) {
    return max(imageLoad(resolved_img, clamp(p, ivec2(0), imageSize(resolved_img)-1)).rgb, vec3(0));
}
AF4 FsrRcasLoadF(ASU2 p) { return vec4(loadColor(p) / color_scale, 1); }
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "fsr/ffx_fsr1.h"
vec4 outputColor(vec3 c) {
#ifdef SRGB_OUTPUT
    c = clamp(c, vec3(0), vec3(1));
    c = mix(c * 12.92, 1.055 * pow(c, vec3(1.0 / 2.4)) - 0.055, greaterThan(c, vec3(0.0031308)));
#endif
    return vec4(c, 1);
}
void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(result_img)))) return;
    float amount = clamp(strength, 0.0, 2.0);
    vec3 center = loadColor(p);
    if (amount == 0.0) {
        imageStore(result_img, p, outputColor(center));
        return;
    }
    // RCAS limits assume normalized color. A shared local scale also handles HDR input.
    vec3 left = loadColor(p+ivec2(-1,0)), right = loadColor(p+ivec2(1,0));
    vec3 top = loadColor(p+ivec2(0,-1)), bottom = loadColor(p+ivec2(0,1));
    vec3 peak = max(center, max(max(left, right), max(top, bottom)));
    color_scale = max(1.0, max(peak.r, max(peak.g, peak.b)));
    vec3 low = min(center, min(min(left, right), min(top, bottom)));
    // RCAS's approximate reciprocal can shift constant color, especially in HDR.
    if (all(lessThanEqual(peak-low, vec3(1e-6*color_scale)))) {
        imageStore(result_img, p, outputColor(center));
        return;
    }
    uvec4 constants = uvec4(floatBitsToUint(exp2(-2.0*(1.0-min(amount, 1.0)))), 0, 0, 0);
    vec3 sharpened;
    FsrRcasF(sharpened.r, sharpened.g, sharpened.b, uvec2(p), constants);
    imageStore(result_img, p, outputColor(clamp(mix(center, sharpened*color_scale, amount),
                                                vec3(0), vec3(color_scale))));
}
